# Corrected descriptive statistics function
desc_stats <- function(data, country_name) {
  data %>%
    dplyr::select(GPU_Demand, Data_Centers, Compute_Power, Cloud_Investment, Training_FLOPS, Model_Count) %>%
    summarise(
      GPU_Mean = mean(GPU_Demand, na.rm = TRUE),
      GPU_SD = sd(GPU_Demand, na.rm = TRUE),
      GPU_Min = min(GPU_Demand, na.rm = TRUE),
      GPU_Max = max(GPU_Demand, na.rm = TRUE),
      DC_Mean = mean(Data_Centers, na.rm = TRUE),
      DC_SD = sd(Data_Centers, na.rm = TRUE),
      CP_Mean = mean(Compute_Power, na.rm = TRUE),
      CP_SD = sd(Compute_Power, na.rm = TRUE),
      Inv_Mean = mean(Cloud_Investment, na.rm = TRUE),
      Inv_SD = sd(Cloud_Investment, na.rm = TRUE),
      Models_Mean = mean(Model_Count, na.rm = TRUE),
      Models_SD = sd(Model_Count, na.rm = TRUE)
    ) %>%
    mutate(Country = country_name)  # Add country after summarise
}

# Run the function
stats_china <- desc_stats(china_hist, "China")
stats_skorea <- desc_stats(skorea_hist, "South Korea")

# Combine results
stats_combined <- bind_rows(stats_china, stats_skorea)
print(stats_combined)


# Step 4: Regression Analysis (Main Results)

# 4.1 Full Sample Regression - China (1990-2025)
lm_china_full <- lm(ln_GPU ~ ln_DC + ln_CP + ln_Inv + ln_FLOPS + ln_Models, 
                    data = china_hist)

summary(lm_china_full)

# Check VIF for multicollinearity
vif_china <- vif(lm_china_full)
print(vif_china)

# 4.2 Full Sample Regression - South Korea
lm_skorea_full <- lm(ln_GPU ~ ln_DC + ln_CP + ln_Inv + ln_FLOPS + ln_Models, 
                     data = skorea_hist)

summary(lm_skorea_full)

vif_skorea <- vif(lm_skorea_full)
print(vif_skorea)

# 4.3 Regression using First Differences (if non-stationary)
# Remove NA rows
china_diff <- china_hist %>% filter(!is.na(d_ln_GPU))
skorea_diff <- skorea_hist %>% filter(!is.na(d_ln_GPU))

lm_china_diff <- lm(d_ln_GPU ~ d_ln_DC + d_ln_CP + d_ln_Inv + d_ln_FLOPS + d_ln_Models, 
                    data = china_diff)

summary(lm_china_diff)

lm_skorea_diff <- lm(d_ln_GPU ~ d_ln_DC + d_ln_CP + d_ln_Inv + d_ln_FLOPS + d_ln_Models, 
                     data = skorea_diff)

summary(lm_skorea_diff)

# 4.4 Structural Break: Split at 2012 (Pre vs. Post Deep Learning)
china_pre2012 <- china_hist %>% filter(Year <= 2013)
china_post2012 <- china_hist %>% filter(Year >= 2014)

skorea_pre2012 <- skorea_hist %>% filter(Year <= 2013)
skorea_post2012 <- skorea_hist %>% filter(Year >= 2014)

# China Pre-2012
lm_china_pre <- lm(ln_GPU ~ ln_DC + ln_CP + ln_Inv + ln_FLOPS + ln_Models, 
                   data = china_pre2012)
summary(lm_china_pre)

# China Post-2012
lm_china_post <- lm(ln_GPU ~ ln_DC + ln_CP + ln_Inv + ln_FLOPS + ln_Models, 
                    data = china_post2012)
summary(lm_china_post)

# South Korea Pre-2012
lm_skorea_pre <- lm(ln_GPU ~ ln_DC + ln_CP + ln_Inv + ln_FLOPS + ln_Models, 
                    data = skorea_pre2012)
summary(lm_skorea_pre)

# South Korea Post-2012
lm_skorea_post <- lm(ln_GPU ~ ln_DC + ln_CP + ln_Inv + ln_FLOPS + ln_Models, 
                     data = skorea_post2012)
summary(lm_skorea_post)



# Step 5: Diagnostic Tests

# 5.1 Durbin-Watson Test (Autocorrelation)
dw_china <- dwtest(lm_china_full)
dw_skorea <- dwtest(lm_skorea_full)

print(dw_china)
print(dw_skorea)

# 5.2 Breusch-Pagan Test (Heteroscedasticity)
bp_china <- bptest(lm_china_full)
bp_skorea <- bptest(lm_skorea_full)

print(bp_china)
print(bp_skorea)

# 5.3 Residual Plots (for Figure 2)
par(mfrow = c(2, 2))
plot(lm_china_full, main = "China Residual Diagnostics")
plot(lm_skorea_full, main = "South Korea Residual Diagnostics")

# 5.4 If autocorrelation exists, use Newey-West standard errors
# install.packages("sandwich")
library(sandwich)
library(lmtest)

coeftest(lm_china_full, vcov = NeweyWest(lm_china_full, lag = 1))
coeftest(lm_skorea_full, vcov = NeweyWest(lm_skorea_full, lag = 1))


# Step 6: Relative Importance (Standardized Coefficients)

# 6.1 Compute standardized coefficients (beta weights)
# Using lm.beta package
# install.packages("lm.beta")
library(lm.beta)

lm_china_beta <- lm.beta(lm_china_full)
summary(lm_china_beta)

lm_skorea_beta <- lm.beta(lm_skorea_full)
summary(lm_skorea_beta)

# 6.2 Extract standardized coefficients for comparison
beta_china <- coef(lm_china_beta)[-1]  # Remove intercept
beta_skorea <- coef(lm_skorea_beta)[-1]

# Create comparison table
beta_comparison <- data.frame(
  Driver = names(beta_china),
  China_Beta = round(beta_china, 3),
  SouthKorea_Beta = round(beta_skorea, 3)
)

print(beta_comparison)

# 6.3 Bar chart for Figure 3
beta_long <- beta_comparison %>%
  pivot_longer(cols = c(China_Beta, SouthKorea_Beta), 
               names_to = "Country", values_to = "Beta")

ggplot(beta_long, aes(x = Driver, y = Beta, fill = Country)) +
  geom_bar(stat = "identity", position = position_dodge()) +
  labs(
    title = "Relative Importance of AI GPU Demand Drivers",
    x = "Driver Variable",
    y = "Standardized Coefficient (Beta)"
  ) +
  theme_minimal() +
  theme(legend.position = "bottom")

