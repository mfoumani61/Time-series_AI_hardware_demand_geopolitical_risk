# Step 2: Load and Prepare Data

# Set working directory (adjust to your path)
# setwd("C:/Your/Path/Here")

# Read the Excel files
# Note: You may need to save as CSV first, or use readxl package
# install.packages("readxl")
library(readxl)

china <- read_excel("C://Users//mfoum//Downloads//ai_China_hardware_demand.xlsx", sheet = "Sheet1")
skorea <- read_excel("C://Users//mfoum//Downloads//ai_SouthKorea_hardware_demand.xlsx", sheet = "Sheet1")

# View structure
str(china)
head(china)

# Rename columns for easier handling
colnames(china) <- c("Year", "GPU_Demand", "Data_Centers", "Compute_Power", 
                     "Cloud_Investment", "Training_FLOPS", "Model_Count")
colnames(skorea) <- c("Year", "GPU_Demand", "Data_Centers", "Compute_Power", 
                      "Cloud_Investment", "Training_FLOPS", "Model_Count")

# Create historical data (1990-2025) - excluding projections (2025-2036)
china_hist <- china %>% filter(Year <= 2025)
skorea_hist <- skorea %>% filter(Year <= 2025)

# Check row counts
nrow(china_hist)  # Should be 36 years 
nrow(skorea_hist) # Should be 36 years

# Create log-transformed variables (to estimate elasticities)
china_hist <- china_hist %>%
  mutate(
    ln_GPU = log(GPU_Demand + 0.001),  # +0.001 to handle zeros in 1990-2012
    ln_DC = log(Data_Centers + 0.001),
    ln_CP = log(Compute_Power + 0.001),
    ln_Inv = log(Cloud_Investment + 0.001),
    ln_FLOPS = log(Training_FLOPS + 0.001),
    ln_Models = log(Model_Count + 0.001)
  )

skorea_hist <- skorea_hist %>%
  mutate(
    ln_GPU = log(GPU_Demand + 0.001),
    ln_DC = log(Data_Centers + 0.001),
    ln_CP = log(Compute_Power + 0.001),
    ln_Inv = log(Cloud_Investment + 0.001),
    ln_FLOPS = log(Training_FLOPS + 0.001),
    ln_Models = log(Model_Count + 0.001)
  )

# Create time series objects for stationarity tests
gpu_china_ts <- ts(china_hist$ln_GPU, start = 1990, frequency = 1)
gpu_skorea_ts <- ts(skorea_hist$ln_GPU, start = 1990, frequency = 1)


